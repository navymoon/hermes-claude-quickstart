# Hindsight API server — local only. Memory extraction runs through the Claude Code CLI login
# on this Mac (your own subscription); no API key is stored here.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT={{PORT}}
HINDSIGHT_API_LLM_PROVIDER=claude-code
HINDSIGHT_API_LLM_MODEL=claude-sonnet-5-5
HINDSIGHT_API_MCP_ENABLED=true
CLAUDE_CODE_EFFORT_LEVEL=medium
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_ID=intfloat/multilingual-e5-small
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=300
HINDSIGHT_API_RERANKER_LOCAL_BUCKET_BATCHING=true
